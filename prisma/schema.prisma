generator client {
  provider        = "prisma-client"
  previewFeatures = ["fullTextSearchPostgres"]
  output          = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CS2ItemExterior {
  FN
  MW
  FT
  WW
  BS
}

model User {
  apiResponseCaches   UserApiResponseCache[]
  authTokens          ApiAuthToken[]
  avatar              String
  createdAt           DateTime                 @default(now())
  groups              UserGroup[]
  id                  String                   @id
  inventoryItems      UserInventoryItem[]
  inventoryProjection UserInventoryProjection?
  inventoryRecoveries UserInventoryRecovery[]
  lastSeenAt          DateTime                 @default(now())
  name                String
  rawInventory        String?
  overrides           UserRule[]
  preferences         UserPreference?
  syncedAt            DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([syncedAt])
}

model EconomyItem {
  altName       String?
  base          Boolean
  baseItemId    Int?
  category      String?
  collectionKey String?
  def           Int?
  free          Boolean
  id            Int            @id
  modelKey      String?
  name          String
  rarityColor   String?
  type          String
  prices        EconomyPrice[]
}

model EconomyPrice {
  currency       String           @default("USD")
  economyItem    EconomyItem      @relation(fields: [economyItemId], references: [id], onDelete: Cascade)
  economyItemId  Int
  exterior       CS2ItemExterior?
  avgPrice24h    Decimal?         @db.Decimal(14, 6)
  avgPrice7d     Decimal?         @db.Decimal(14, 6)
  avgPrice30d    Decimal?         @db.Decimal(14, 6)
  avgPrice90d    Decimal?         @db.Decimal(14, 6)
  marketHashName String
  sourceDate     DateTime         @db.Date
  souvenir       Boolean          @default(false)
  statTrak       Boolean          @default(false)

  @@id([sourceDate, marketHashName])
  @@index([economyItemId, sourceDate])
}

model EconomyPriceSyncState {
  id                      Int       @id @default(1)
  lastAttemptedAt         DateTime?
  lastAttemptedSourceDate DateTime? @db.Date
  lastFailureAt           DateTime?
  lastFailureMessage      String?
  lastSucceededAt         DateTime?
  lastSucceededSourceDate DateTime? @db.Date
  lastUnmatchedCount      Int?
  lastUnmatchedNames      String?
  updatedAt               DateTime  @updatedAt
}

model UserInventoryItem {
  charges           Int?
  containerUid      Int?
  equipped          Boolean                     @default(false)
  equippedCT        Boolean                     @default(false)
  equippedT         Boolean                     @default(false)
  id                String                      @id @default(uuid())
  inventoryKey      String
  itemId            Int
  itemUpdatedAt     DateTime?
  keychains         UserInventoryItemKeychain[]
  nameTag           String?
  patches           UserInventoryItemPatch[]
  seed              Int?
  sourceContainerId Int?
  statTrak          Int?
  stickers          UserInventoryItemSticker[]
  uid               Int
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  wear              Float?

  @@unique([userId, inventoryKey])
  @@index([itemId])
}

model UserInventoryItemSticker {
  id                  String            @id @default(uuid())
  itemId              Int
  rotation            Float?
  schema              Int?
  slot                Int
  userInventoryItem   UserInventoryItem @relation(fields: [userInventoryItemId], references: [id], onDelete: Cascade)
  userInventoryItemId String
  wear                Float?
  x                   Float?
  y                   Float?

  @@unique([userInventoryItemId, slot])
  @@index([itemId])
}

model UserInventoryItemPatch {
  id                  String            @id @default(uuid())
  itemId              Int
  slot                Int
  userInventoryItem   UserInventoryItem @relation(fields: [userInventoryItemId], references: [id], onDelete: Cascade)
  userInventoryItemId String

  @@unique([userInventoryItemId, slot])
  @@index([itemId])
}

model UserInventoryItemKeychain {
  id                  String            @id @default(uuid())
  itemId              Int
  seed                Int?
  slot                Int
  userInventoryItem   UserInventoryItem @relation(fields: [userInventoryItemId], references: [id], onDelete: Cascade)
  userInventoryItemId String
  x                   Float?
  y                   Float?
  z                   Float?

  @@unique([userInventoryItemId, slot])
  @@index([itemId])
}

model UserInventoryProjection {
  /// Copy of User.syncedAt for the last failed projection attempt. Cleared on
  /// success, unlike projectedUserSyncedAt, which is never cleared: after a
  /// failure both may be set, holding different watermarks.
  failedUserSyncedAt    DateTime?
  projectedAt           DateTime?
  projectedUserSyncedAt DateTime?
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String    @id
}

model InventoryProjectionState {
  backfillCompletedAt      DateTime?
  backfillCursor           String?
  cs2LibVersion            String?
  economyProjectionVersion Int       @default(1)
  id                       Int       @id @default(1)
  updatedAt                DateTime  @updatedAt
}

model UserInventoryRecovery {
  changes      String?
  createdAt    DateTime @default(now())
  id           String   @id @default(uuid())
  rawInventory String
  reason       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  @@index([userId])
}

model UserApiResponseCache {
  args         String?
  body         String
  url          String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  /// Copy of User.syncedAt at write time, used as the cache-validity
  /// watermark: a response is reused only while the user has not re-synced.
  userSyncedAt DateTime

  @@id([url, userId])
}

model UserPreference {
  background            String?
  hideFilters           String?
  hideFreeItems         String?
  hideNewItemLabel      String?
  language              String?
  prefer2dStickerEditor String?
  statsForNerds         String?
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String  @id
}

model ApiCredential {
  apiKey     String         @id
  authTokens ApiAuthToken[]
  comment    String?
  createdAt  DateTime       @default(now())
  scope      String?
  updatedAt  DateTime       @updatedAt
}

model ApiAuthToken {
  createdAt        DateTime      @default(now())
  credential       ApiCredential @relation(fields: [credentialApiKey], references: [apiKey], onDelete: Cascade)
  credentialApiKey String
  token            String        @id @default(uuid())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
}

model Rule {
  groupOverrides GroupRule[]
  name           String      @id @unique
  type           String      @default("string")
  userOverrides  UserRule[]
  value          String
}

model UserRule {
  name   String
  rule   Rule   @relation(fields: [name], references: [name], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  value  String

  @@id([name, userId])
}

model Group {
  id        String      @id
  overrides GroupRule[]
  priority  Int         @default(0)
  users     UserGroup[]
}

model UserGroup {
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@id([groupId, userId])
}

model GroupRule {
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  name    String
  rule    Rule   @relation(fields: [name], references: [name], onDelete: Cascade)
  value   String

  @@id([groupId, name])
}

model RateLimitBucket {
  key       String   @id
  tokens    Float
  updatedAt DateTime
}
